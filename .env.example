DATABASE_URL=postgres://postgres:postgres@localhost/aframp
# Use 0.0.0.0:3000 in a container deployment.
APP_BIND_ADDR=127.0.0.1:3000
JWT_SECRET=replace-in-production
WEBHOOK_SECRET=replace-in-production
# openssl rand -hex 32 — used to AES-256-GCM encrypt per-wallet Stellar secret seeds at rest
WALLET_ENCRYPTION_KEY=replace-in-production
STELLAR_SYSTEM_WALLET_ADDRESS=G...YOUR_STELLAR_SYSTEM_WALLET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_POLL_INTERVAL_SECS=60
# Paystack Dashboard > Settings > API Keys & Webhooks. sk_test_... for dev, sk_live_... only once
# the business is verified/activated for Transfers (see PRD §9.1).
PAYSTACK_SECRET_KEY=sk_test_replace-in-production
# Verified Stellar issuer address for cNGN tokens. Required to generate SEP-0007 payment URIs
# for cNGN payment requests. If unset or invalid, cNGN payment requests will have no sep7_uri
# (existing null behavior preserved for safety). Leave empty or unset to disable cNGN URIs.
CNGN_ISSUER_ADDRESS=
# Comma-separated browser origins allowed to call the API. Unlisted origins fail preflight.
CORS_ALLOWED_ORIGINS=http://localhost:3001
# Session cookie. Leave these alone unless the frontend is on a different origin than the API:
# browsers treat localhost as a secure context, so Secure works in dev too. SameSite=none lets
# the session ride cross-site requests (and forces Secure) — prefer serving the frontend
# same-origin behind one reverse proxy. See README "Deploying behind TLS".
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# Login rate limiting: protect against password guessing attacks
# Maximum login attempts allowed per window (default: 5)
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# Time window in seconds for rate limiting (default: 300 = 5 minutes)
LOGIN_RATE_LIMIT_WINDOW_SECS=300
#
# ============================================================================
# SETTLEMENT PIPELINE CONFIGURATION (Sweep, Redemption, and Payout)
# ============================================================================
# Global settlement enable flag. DEFAULT: false (disabled until approvals obtained).
# Set to true only after:
#   1. Issuer integration is complete and tested
#   2. Compliance & legal approvals are obtained
#   3. Staging environment settlement cycle succeeds end-to-end
SETTLEMENT_ENABLED=false
# How often the settlement worker runs (in seconds). DEFAULT: 3600 (1 hour).
# The worker identifies eligible wallets, sweeps cNGN to the platform wallet,
# requests redemption from the issuer, and marks batches ready for payout.
SETTLEMENT_INTERVAL_SECS=3600
# Optional: lock settlement cycles to a specific UTC hour each day (e.g., "02:00").
# When set, the worker only processes during that hour. Leave unset for no time-based lock.
# SETTLEMENT_WINDOW_START_UTC=02:00
# Minimum cNGN balance (in stroops) required to trigger a sweep.
# DEFAULT: 10000000 (approximately 10 cNGN). Set higher to batch larger amounts.
SETTLEMENT_MIN_BALANCE_STROOPS=10000000
# Maximum retry attempts per sweep batch before marking terminal_failed (ops alert).
# DEFAULT: 5. Retryable failures (network timeout, issuer temporarily unavailable) will
# be retried up to this many times. Terminal failures require ops intervention.
SETTLEMENT_MAX_RETRIES=5
# Issuer API endpoint for cNGN → NGN redemption. REQUIRED if SETTLEMENT_ENABLED=true.
# Example: https://issuer.example.com/api/v1/redeem
SETTLEMENT_ISSUER_API_URL=
# Issuer API credentials (bearer token, API key, etc.). REQUIRED if SETTLEMENT_ENABLED=true.
# Stored in AWS Secrets Manager or equivalent in production; never committed to .env.
# Example format: "Bearer token123..." or "ApiKey: key123..."
SETTLEMENT_ISSUER_API_KEY=
# Timeout (in seconds) for issuer API calls. DEFAULT: 30 seconds.
SETTLEMENT_ISSUER_MAX_TIMEOUT_SECS=30
